<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>APOLLON | Admin</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#08080e;color:white;font-family:Arial;min-height:100vh;display:grid;place-items:center;padding:20px}
.login{width:100%;max-width:410px;background:#13131e;border:1px solid #38304b;border-radius:20px;padding:35px;box-shadow:0 20px 70px #000}
.logo{text-align:center;font-size:32px;font-weight:900;letter-spacing:6px;color:#bd79ff}
.tag{text-align:center;color:#888;margin:12px 0 35px;font-size:11px;letter-spacing:3px}
h2{text-align:center}
p{text-align:center;color:#999;font-size:13px}
label{display:block;margin:22px 0 8px;color:#bbb}
input{width:100%;padding:15px;background:#090911;border:1px solid #38304b;border-radius:9px;color:white}
button{width:100%;padding:15px;margin-top:25px;border:0;border-radius:9px;background:linear-gradient(100deg,#812cff,#c02b83);color:white;font-weight:bold}
.error{color:#ff6666;text-align:center;margin-top:18px}
.back{display:block;text-align:center;margin-top:25px;color:#999;text-decoration:none;font-size:12px}
</style>
</head>
<body>
<div class="login">
<div class="logo">APOLLON</div>
<div class="tag">SECURE CONTROL CENTER</div>
<h2>YONETICI GIRISI</h2>
<p>Yonetim paneline hos geldin.</p>

<form action="/admin" method="POST">
<label>Kullanici adi</label>
<input name="username" required autocomplete="username">

<label>Sifre</label>
<input type="password" name="password" required autocomplete="current-password">

<button type="submit">SISTEME GIR</button>
</form>

<% if (typeof error !== "undefined" && error) { %>
<div class="error"><%= error %></div>
<% } %>

<a class="back" href="/">Ana sayfaya don</a>
</div>
</body>
</html>
